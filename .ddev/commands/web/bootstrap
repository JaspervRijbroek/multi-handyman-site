#!/usr/bin/env bash

## Description: Install dependencies, create the database schema and load demo data
## Usage: bootstrap
## Example: "ddev bootstrap"

set -euo pipefail

composer install --no-interaction

# First run only: generate the initial migration from the entities.
# Commit the generated file in migrations/ afterwards.
if ! ls migrations/Version*.php >/dev/null 2>&1; then
    php bin/console doctrine:migrations:diff --no-interaction
fi

php bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration
php bin/console doctrine:fixtures:load --no-interaction

cat <<'EOF'

Done. Try:
  Admin:        https://multi-handyman-site.ddev.site/admin
                admin@example.com / admin  (super admin)
                jan@example.com / jan      (client: Jan's Klusbedrijf)
  Client sites: https://jans-klusbedrijf.ddev.site
                https://handyman-javea.ddev.site
  Mail:         ddev mailpit
EOF
