<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% for locale in tenant.locales %}
    <url>
        <loc>{{ url('site_home', {_locale: locale}) }}</loc>
{% for alt_locale in tenant.locales %}
        <xhtml:link rel="alternate" hreflang="{{ alt_locale }}" href="{{ url('site_home', {_locale: alt_locale}) }}"/>
{% endfor %}
    </url>
{% endfor %}
</urlset>
