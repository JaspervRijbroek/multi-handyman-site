<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{% set pages = [{route: 'site_home', params: {}}] %}
{% for project in projects %}
    {% set pages = pages|merge([{route: 'site_project', params: {id: project.id}}]) %}
{% endfor %}
{% for page in pages %}
{% for locale in tenant.locales %}
    <url>
        <loc>{{ url(page.route, page.params|merge({_locale: locale})) }}</loc>
{% for alt_locale in tenant.locales %}
        <xhtml:link rel="alternate" hreflang="{{ alt_locale }}" href="{{ url(page.route, page.params|merge({_locale: alt_locale})) }}"/>
{% endfor %}
    </url>
{% endfor %}
{% endfor %}
</urlset>
