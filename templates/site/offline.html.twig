<!DOCTYPE html>
<html lang="{{ tenant.defaultLocale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ tenant.name }}</title>
    <style>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: #1c2430; background: #f5f7f9; padding: 16px; box-sizing: border-box; }
        div { max-width: 480px; text-align: center; }
        h1 { font-size: 1.5rem; margin: 0 0 8px; }
        p { margin: 0 0 8px; color: #5b6573; }
        a { color: inherit; }
    </style>
</head>
<body>
<div>
    <h1>{{ tenant.name }}</h1>
    <p>{{ 'offline.message'|trans({}, 'messages', tenant.defaultLocale) }}</p>
    {% if tenant.phone %}<p><a href="tel:{{ tenant.phoneLink }}">{{ tenant.phone }}</a></p>{% endif %}
    {% if tenant.email %}<p><a href="mailto:{{ tenant.email }}">{{ tenant.email }}</a></p>{% endif %}
</div>
</body>
</html>
