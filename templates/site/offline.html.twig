<!DOCTYPE html>
<html lang="{{ tenant.defaultLocale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ tenant.name }}</title>
    <style>
        @font-face { font-family: "Young Serif"; src: url("{{ asset('fonts/young-serif.woff2') }}") format("woff2"); font-display: swap; }
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font: 17px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; color: #2b2622; background: #faf5ec; padding: 16px; box-sizing: border-box; }
        div { max-width: 480px; text-align: center; }
        h1 { font: 400 2.25rem/1.05 "Young Serif", Georgia, serif; color: #1d1a17; margin: 0 0 12px; }
        p { margin: 0 0 8px; color: #5a4f45; }
        a { color: inherit; }
    </style>
</head>
<body>
<div>
    <h1>{{ tenant.name }}</h1>
    <p>{{ 'offline.message'|trans({}, 'messages', tenant.defaultLocale) }}</p>
    {% if tenant.phone %}<p><a href="tel:{{ tenant.phoneLink }}">{{ tenant.phone }}</a></p>{% endif %}
    {% if tenant.email %}<p><a href="mailto:{{ tenant.email }}">{{ tenant.email }}</a></p>{% endif %}
</div>
</body>
</html>
