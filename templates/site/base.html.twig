{% set route = app.request.attributes.get('_route') %}
{% set route_params = app.request.attributes.get('_route_params')|default({}) %}
{% set locale = app.request.locale %}
{% set home = path('site_home', {_locale: locale}) %}
<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ tenant.name }}{% if tenant.tagline|localized %} | {{ tenant.tagline|localized }}{% endif %}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ tenant.intro|localized|slice(0, 155) }}{% endblock %}">
    {# Search Console: the automatic token (onboarding) and an optional manual one #}
    {% if tenant.searchConsoleToken %}
        <meta name="google-site-verification" content="{{ tenant.searchConsoleToken }}">
    {% endif %}
    {% if tenant.googleSiteVerification and tenant.googleSiteVerification != tenant.searchConsoleToken %}
        <meta name="google-site-verification" content="{{ tenant.googleSiteVerification }}">
    {% endif %}

    <link rel="canonical" href="{{ url(route, route_params) }}">
    {% for alt_locale in tenant.locales %}
        <link rel="alternate" hreflang="{{ alt_locale }}" href="{{ url(route, route_params|merge({_locale: alt_locale})) }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ url(route, route_params|merge({_locale: tenant.defaultLocale})) }}">

    <meta property="og:title" content="{{ tenant.name }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ url(route, route_params) }}">
    {% if tenant.logoName %}
        <meta property="og:image" content="{{ absolute_url(asset('uploads/logos/' ~ tenant.logoName)) }}">
    {% endif %}

    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="preload" href="{{ asset('fonts/young-serif.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ asset('css/site.css') }}">
    <style>:root { --primary: {{ tenant.primaryColor }}; }</style>

    {% if tenant.plausibleDomain %}
        <script defer data-domain="{{ tenant.plausibleDomain }}" src="https://plausible.io/js/script.js"></script>
    {% endif %}
    {% block head %}{% endblock %}
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="{{ home }}">
                {%- if tenant.logoName -%}
                    <img src="{{ asset('uploads/logos/' ~ tenant.logoName) }}" alt="" height="44">
                {%- else -%}
                    <span class="brand-mark" aria-hidden="true">{{ tenant.initials }}</span>
                {%- endif -%}
                <span>{{ tenant.name }}</span>
            </a>
            <nav class="nav" aria-label="Main">
                <a href="{{ home }}#services">{{ 'nav.services'|trans }}</a>
                <a href="{{ home }}#projects">{{ 'nav.projects'|trans }}</a>
                <a href="{{ home }}#reviews">{{ 'nav.reviews'|trans }}</a>
            </nav>
            {% if tenant.locales|length > 1 %}
                <nav class="lang" aria-label="Language">
                    {% for alt_locale in tenant.locales %}
                        <a href="{{ path(route, route_params|merge({_locale: alt_locale})) }}"
                           {% if alt_locale == locale %}aria-current="true"{% endif %}
                           hreflang="{{ alt_locale }}">{{ alt_locale|upper }}</a>
                    {% endfor %}
                </nav>
            {% endif %}
            <a class="btn btn-primary btn-small" href="{{ home }}#contact">{{ 'nav.contact'|trans }}</a>
        </div>
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <p>&copy; {{ 'now'|date('Y') }} {{ tenant.name }}{% if tenant.publicAddressLine %} · {{ tenant.publicAddressLine }}{% endif %}{% if tenant.serviceArea %} · {{ tenant.serviceArea }}{% endif %}</p>
            <p><a href="{{ path('site_legal', {_locale: locale}) }}">{{ 'footer.legal'|trans }}</a></p>
        </div>
    </footer>

    {% if tenant.whatsappDigits %}
        <a class="whatsapp-fab"
           href="https://wa.me/{{ tenant.whatsappDigits }}?text={{ 'whatsapp.prefill'|trans({'%name%': tenant.name})|url_encode }}"
           target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3C8.8 3 3 8.7 3 15.8c0 2.5.7 4.9 2 7L3 29l6.4-2c2 1.1 4.3 1.7 6.6 1.7 7.2 0 13-5.7 13-12.8C29 8.7 23.2 3 16 3zm0 23.4c-2.1 0-4.1-.6-5.9-1.7l-.4-.3-3.8 1.2 1.2-3.7-.3-.4a10.4 10.4 0 0 1-1.7-5.7C5.1 10 10 5.2 16 5.2S26.9 10 26.9 15.8 22 26.4 16 26.4zm6-7.8c-.3-.2-1.9-1-2.2-1.1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1-.3-.2-1.4-.5-2.6-1.6-1-.9-1.6-1.9-1.8-2.2-.2-.3 0-.5.1-.7l.5-.6.3-.5c.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.6 5.8 5 .8.4 1.4.6 1.9.7.8.3 1.5.2 2.1.1.6-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.3-.6-.4z"/></svg>
        </a>
    {% endif %}
</body>
</html>
