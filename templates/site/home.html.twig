{% extends 'site/base.html.twig' %}

{% block head %}
    {% if turnstile_site_key() %}
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    {% endif %}
    {% set address = tenant.hasAddress ? {
        '@type': 'PostalAddress',
        'streetAddress': tenant.showStreetAddress ? tenant.streetAddress : null,
        'postalCode': tenant.postalCode,
        'addressLocality': tenant.city,
        'addressCountry': tenant.country,
    }|filter(v => v is not empty) : null %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'HomeAndConstructionBusiness',
        'name': tenant.name,
        'url': url('site_root'),
        'description': tenant.intro|localized,
        'telephone': tenant.phone,
        'email': tenant.email,
        'address': address,
        'geo': tenant.hasCoordinates and tenant.showStreetAddress ? {'@type': 'GeoCoordinates', 'latitude': tenant.latitude, 'longitude': tenant.longitude} : null,
        'hasMap': tenant.mapUrl,
        'sameAs': tenant.googleBusinessUrl ? [tenant.googleBusinessUrl] : null,
        'areaServed': tenant.serviceArea,
        'logo': tenant.logoName ? absolute_url(asset('uploads/logos/' ~ tenant.logoName)) : null,
    }|filter(v => v is not empty)|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endblock %}

{% block body %}
    {% set hero_project = projects|filter(p => p.imageName)|first %}
    <section class="hero">
        <div class="container hero-grid">
            <div class="hero-copy">
                {% if tenant.serviceArea %}
                    <p class="badges"><span class="badge">{{ 'hero.area'|trans }}: {{ tenant.serviceArea }}</span></p>
                {% endif %}
                <h1>{{ tenant.tagline|localized ?: tenant.name }}</h1>
                {% if tenant.intro|localized %}
                    <p class="lead">{{ tenant.intro|localized|nl2br }}</p>
                {% endif %}
                <div class="cta">
                    <a class="btn btn-primary" href="#contact">{{ 'hero.quote'|trans }}</a>
                    {% if tenant.phoneLink %}
                        <a class="btn btn-secondary" href="tel:{{ tenant.phoneLink }}">{{ 'hero.call'|trans }} {{ tenant.phone }}</a>
                    {% endif %}
                    {% if tenant.whatsappDigits %}
                        <a class="btn btn-whatsapp" href="https://wa.me/{{ tenant.whatsappDigits }}?text={{ 'whatsapp.prefill'|trans({'%name%': tenant.name})|url_encode }}" target="_blank" rel="noopener">WhatsApp</a>
                    {% endif %}
                </div>
            </div>
            {# Arch-shaped photo: the newest project with a picture, otherwise a tile pattern #}
            <div class="hero-photo{{ hero_project ? '' : ' hero-photo-empty' }}">
                {% if hero_project %}
                    <img src="{{ asset('uploads/projects/' ~ hero_project.imageName) }}" alt="{{ hero_project.title|localized }}" width="460" height="552">
                {% endif %}
            </div>
        </div>
    </section>

    {% if tenant.about|localized or services is not empty %}
        <section id="services" class="section">
            <div class="container split">
                <div class="stack">
                    <p class="eyebrow">{{ 'about.title'|trans }}</p>
                    <h2>{{ tenant.name }}</h2>
                    {% if tenant.about|localized %}
                        <p class="muted">{{ tenant.about|localized|nl2br }}</p>
                    {% endif %}
                </div>
                {% if services is not empty %}
                    <div>
                        <p class="eyebrow">{{ 'services.title'|trans }}</p>
                        <ul class="service-list">
                            {% for service in services %}
                                <li>
                                    <h3>{{ service.title|localized }}</h3>
                                    {% if service.description|localized %}
                                        <p>{{ service.description|localized|nl2br }}</p>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </section>
    {% endif %}

    {% if projects is not empty %}
        <section id="projects" class="section section-alt">
            <div class="container">
                <h2>{{ 'projects.title'|trans }}</h2>
                <div class="projects">
                    {% for project in projects %}
                        <figure class="project">
                            {% if project.imageName %}
                                <img src="{{ asset('uploads/projects/' ~ project.imageName) }}"
                                     alt="{{ project.title|localized }}" loading="lazy" width="400" height="500">
                            {% else %}
                                <div class="project-placeholder" aria-hidden="true"></div>
                            {% endif %}
                            <figcaption>
                                <strong>{{ project.title|localized }}</strong>
                                {% if project.description|localized %}<span>{{ project.description|localized }}</span>{% endif %}
                                {% if project.completedAt %}<time datetime="{{ project.completedAt|date('Y-m-d') }}">{{ project.completedAt|date('m/Y') }}</time>{% endif %}
                            </figcaption>
                        </figure>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section id="contact" class="section">
        <div class="container contact">
            <div class="stack">
                <h2>{{ 'contact.title'|trans }}</h2>
                <p class="muted">{{ 'contact.intro'|trans }}</p>
                <ul class="contact-details">
                    {% if tenant.phoneLink %}<li><a href="tel:{{ tenant.phoneLink }}">{{ tenant.phone }}</a></li>{% endif %}
                    {% if tenant.whatsappDigits %}<li><a href="https://wa.me/{{ tenant.whatsappDigits }}" target="_blank" rel="noopener">WhatsApp</a></li>{% endif %}
                    {% if tenant.publicAddressLine %}<li>{{ tenant.publicAddressLine }}</li>{% endif %}
                    {% if tenant.serviceArea %}<li>{{ tenant.serviceArea }}</li>{% endif %}
                    {% if tenant.googleBusinessUrl %}<li><a href="{{ tenant.googleBusinessUrl }}" target="_blank" rel="noopener">{{ 'map.google'|trans }}</a></li>{% endif %}
                </ul>

                {% if tenant.mapEmbedUrl %}
                    {# OpenStreetMap is only loaded after a click: until then no visitor data goes to a third party #}
                    <div class="map">
                        <button type="button" class="btn btn-secondary map-load"
                                data-src="{{ tenant.mapEmbedUrl }}"
                                data-title="{{ 'map.iframe'|trans({'%name%': tenant.name}) }}">{{ 'map.show'|trans }}</button>
                        <p class="map-note">{{ 'map.notice'|trans }}</p>
                    </div>
                    <p class="map-credit">
                        <a href="{{ tenant.mapUrl }}" target="_blank" rel="noopener">{{ 'map.open'|trans }}</a>
                        · © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
                    </p>
                    <script>
                        document.querySelector('.map-load').addEventListener('click', function () {
                            var frame = document.createElement('iframe');
                            frame.src = this.dataset.src;
                            frame.title = this.dataset.title;
                            frame.loading = 'lazy';
                            frame.referrerPolicy = 'strict-origin-when-cross-origin';
                            frame.allowFullscreen = true;
                            this.parentNode.replaceChildren(frame);
                        });
                    </script>
                {% endif %}
            </div>
            <div class="contact-card">
                {% for message in app.flashes('contact_success') %}
                    <p class="notice" role="status">{{ message|trans }}</p>
                {% endfor %}
                {{ form_start(form, {attr: {class: 'contact-form', novalidate: 'novalidate'}}) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.name) }}
                    {{ form_row(form.contact) }}
                    {{ form_row(form.message) }}
                    {{ form_row(form.website) }}
                    {% if turnstile_site_key() %}
                        <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key() }}" data-action="contact" data-language="{{ app.request.locale }}"></div>
                    {% endif %}
                    <p class="privacy-note">{{ 'contact.privacy'|trans({'%url%': path('site_legal', {_locale: app.request.locale}) ~ '#privacy'})|raw }}</p>
                    <button type="submit" class="btn btn-primary">{{ 'contact.send'|trans }}</button>
                {{ form_end(form) }}
            </div>
        </div>
    </section>
{% endblock %}
