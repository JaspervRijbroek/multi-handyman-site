{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Welcome{% if tenant %}, {{ tenant.name }}{% endif %}{% endblock %}

{% block main %}
    {% if pending_signups > 0 %}
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-3 mb-3">
            <div class="flex-grow-1">
                <strong>{{ pending_signups }} {{ pending_signups == 1 ? 'sign-up is' : 'sign-ups are' }} waiting for approval.</strong>
                Approving creates the client, domain, login and Google setup in one go.
            </div>
            <a class="btn btn-sm btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\SignupCrudController').setAction('index') }}">Review sign-ups</a>
        </div>
    {% endif %}

    <div class="row">
        {% for stat in stats %}
            <div class="col-sm-6 col-lg-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted small">{{ stat.label }}</div>
                        <div class="fs-2 fw-bold">{{ stat.value }}</div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if tenant and not tenant.billingExempt %}
        {% if outstanding is not empty %}
            <div class="alert alert-danger d-flex flex-wrap align-items-center gap-3 mt-3">
                <div class="flex-grow-1">
                    {% if tenant.suspended %}
                        <strong>Your website is offline.</strong> We did not receive payment. Pay now and it is back online straight away.
                    {% else %}
                        <strong>Open payment.</strong> The automatic payment for {{ outstanding|map(c => c.periodLabel)|join(', ') }} did not come through.
                    {% endif %}
                </div>
                <a class="btn btn-sm btn-danger" href="{{ path('admin_billing_index') }}">Pay now</a>
            </div>
        {% elseif not tenant.hasMandate %}
            <div class="alert alert-info d-flex flex-wrap align-items-center gap-3 mt-3">
                <div class="flex-grow-1">
                    <strong>Set up payment.</strong>
                    {% if tenant.billingStartsOn > date() %}Your website is free until {{ tenant.billingStartsOn|date('j F Y') }}. {% endif %}
                    Add a card or bank account so it is paid automatically after that.
                </div>
                <a class="btn btn-sm btn-primary" href="{{ path('admin_billing_index') }}">Set up payment</a>
            </div>
        {% endif %}
    {% endif %}

    {% if tenant and missing_settings is not empty %}
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-3 mt-3">
            <div class="flex-grow-1">
                <strong>Complete your settings.</strong>
                Add {{ missing_settings|join(', ', ' and ') }} so customers, Google and AI assistants can find you.
            </div>
            <a class="btn btn-sm btn-warning" href="{{ ea_url().setController('App\\Controller\\Admin\\TenantCrudController').setAction('edit').setEntityId(tenant.id) }}">Open settings</a>
        </div>
    {% endif %}

    {% if pending_domain %}
        <div class="alert alert-info d-flex flex-wrap align-items-center gap-3 mt-3">
            <div class="flex-grow-1">
                <strong>{{ pending_domain.hostname }} is not live yet.</strong>
                Set its DNS records where you bought the domain; your website moves there by itself.
            </div>
            <a class="btn btn-sm btn-primary" href="{{ path('admin_own_domain_index') }}">Show what to set</a>
        </div>
    {% endif %}

    {% if tenant %}
        <div class="card mt-3">
            <div class="card-body">
                <h2 class="h5">Keep your website alive</h2>
                <p class="mb-3">Customers trust businesses that show recent work. Finished a job? Add a photo, it takes a minute.</p>
                <a class="btn btn-primary" href="{{ ea_url().setController('App\\Controller\\Admin\\ProjectCrudController').setAction('new') }}">Add a finished job</a>
                {% if site_url %}
                    <a class="btn btn-secondary ms-2" href="{{ site_url }}" target="_blank" rel="noopener">View your website</a>
                {% endif %}
            </div>
        </div>
    {% endif %}
{% endblock %}
