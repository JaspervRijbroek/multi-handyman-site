<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Payment · {{ billing_brand }}</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <style>
        :root { --ink: #1c2430; --muted: #5b6573; --line: #e3e7ec; --bg: #f5f7f9; --primary: #d9480f; --ok: #2b8a3e; --warn: #c92a2a; }
        * { box-sizing: border-box; }
        body { margin: 0; font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--ink); background: var(--bg); }
        main { max-width: 560px; margin: 0 auto; padding: 40px 16px; }
        .b-brand { font-weight: 700; color: var(--muted); margin-bottom: 16px; }
        .b-card { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 24px; }
        h1 { font-size: 1.5rem; margin: 0 0 8px; }
        p { margin: 0 0 16px; }
        .b-muted { color: var(--muted); }
        table { width: 100%; border-collapse: collapse; margin: 0 0 16px; }
        td { padding: 8px 0; border-bottom: 1px solid var(--line); }
        td:last-child { text-align: right; white-space: nowrap; }
        tr.b-total td { font-weight: 700; border-bottom: 0; }
        .b-btn { display: inline-block; width: 100%; padding: 12px 18px; border: 0; border-radius: 8px; background: var(--primary); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
        .b-btn-ghost { background: #fff; color: var(--ink); border: 1px solid var(--line); }
        .b-methods { display: grid; gap: 12px; }
        .b-methods small { display: block; color: var(--muted); margin-top: 4px; }
        .b-alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
        .b-alert-warn { background: #fff5f5; color: var(--warn); border: 1px solid #ffc9c9; }
        .b-alert-ok { background: #ebfbee; color: var(--ok); border: 1px solid #b2f2bb; }
        .b-reason { color: var(--muted); font-size: .875rem; }
        footer { margin-top: 16px; font-size: .875rem; color: var(--muted); text-align: center; }
    </style>
</head>
<body>
<main>
    <div class="b-brand">{{ billing_brand }}</div>
    <div class="b-card">
        {% for message in app.flashes('billing_error') %}
            <div class="b-alert b-alert-warn">{{ message }}</div>
        {% endfor %}

        {% if outstanding is not empty %}
            {% if tenant.suspended %}
                <div class="b-alert b-alert-warn">Your website is offline because of this open payment. It comes back as soon as you pay.</div>
            {% elseif app.request.query.get('returned') %}
                <div class="b-alert b-alert-warn">We have not received the payment yet. If you just paid by bank transfer, it can take a moment.</div>
            {% endif %}

            <h1>Open payment for {{ tenant.name }}</h1>
            <p class="b-muted">Your website subscription, including VAT.</p>
            <table>
                {% for charge in outstanding %}
                    <tr>
                        <td>
                            {{ charge.periodLabel }}
                            {% if charge.failureReason %}<div class="b-reason">{{ charge.failureReason }}</div>{% endif %}
                        </td>
                        <td>{{ charge.totalAmount|money(charge.currency) }}</td>
                    </tr>
                {% endfor %}
                <tr class="b-total"><td>Total</td><td>{{ total|money(outstanding[0].currency) }}</td></tr>
            </table>
            <form method="post" action="{{ path('billing_pay_outstanding', {token: tenant.billingToken}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('billing-' ~ tenant.id) }}">
                <button class="b-btn" type="submit">Pay {{ total|money(outstanding[0].currency) }}</button>
            </form>
            <p class="b-muted" style="margin: 12px 0 0">Paying with a card or your bank also sets up automatic payment for the next months.</p>

        {% elseif tenant.billingExempt %}
            <h1>Nothing to pay</h1>
            <p class="b-muted">Your website is free of charge. Enjoy!</p>

        {% elseif not tenant.hasMandate %}
            {% if app.request.query.get('returned') %}
                <div class="b-alert b-alert-warn">The payment method was not set up. Please try again.</div>
            {% endif %}
            <h1>Set up payment for {{ tenant.name }}</h1>
            <p>
                {% if tenant.billingStartsOn > date() %}
                    Your website is free until <strong>{{ tenant.billingStartsOn|date('l j F Y') }}</strong>.
                    From then on it is charged automatically on the 1st of every month.
                {% else %}
                    Your website is charged automatically on the 1st of every month.
                {% endif %}
                Choose how you want to pay:
            </p>
            {{ include('billing/_setup_buttons.html.twig') }}

        {% else %}
            {% if app.request.query.get('returned') %}
                <div class="b-alert b-alert-ok">Thank you, everything is set up.</div>
            {% endif %}
            <h1>You're all set</h1>
            <p>
                Your website is paid automatically with <strong>{{ tenant.mandateDescription }}</strong>
                on the 1st of every month{% if tenant.billingStartsOn > date() %}, starting {{ tenant.billingStartsOn|date('j F Y') }}{% endif %}.
            </p>
            <details>
                <summary class="b-muted">Use a different card or bank account</summary>
                <div style="margin-top: 12px">{{ include('billing/_setup_buttons.html.twig') }}</div>
            </details>
        {% endif %}
    </div>
    <footer>Payments are handled securely by Mollie.</footer>
</main>
</body>
</html>
