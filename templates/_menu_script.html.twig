{# Mobile header: opens and closes the menu and the language dropdown. Only one is open at a time;
   Escape, a tap outside the dropdown or a tap on a menu link closes them. #}
<script>
    (function () {
        var header = document.querySelector('.menu-toggle').closest('header');
        var menuButton = header.querySelector('.menu-toggle');
        var langButton = header.querySelector('.ls-btn');
        var langMenu = document.getElementById('lang-menu');

        function setMenu(open) {
            header.classList.toggle('is-open', open);
            menuButton.setAttribute('aria-expanded', open);
            menuButton.setAttribute('aria-label', open ? menuButton.dataset.close : menuButton.dataset.open);
            if (open) setLang(false);
        }
        function setLang(open) {
            if (!langButton) return;
            langMenu.hidden = !open;
            langButton.setAttribute('aria-expanded', open);
            if (open) setMenu(false);
        }

        menuButton.addEventListener('click', function () { setMenu(!header.classList.contains('is-open')); });
        document.getElementById('site-menu').addEventListener('click', function (e) {
            if (e.target.closest('a')) setMenu(false);
        });
        if (langButton) {
            langButton.addEventListener('click', function () { setLang(langMenu.hidden); });
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.ls')) setLang(false);
            });
        }
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { setMenu(false); setLang(false); }
        });
    })();
</script>
