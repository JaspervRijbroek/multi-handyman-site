{% extends 'platform/layout.html.twig' %}
{% trans_default_domain 'platform' %}

{% block title %}{{ 'signup.page_title'|trans }} | {{ brand }}{% endblock %}
{% block robots %}index, follow{% endblock %}

{% block body %}
    <p class="p-eyebrow">{{ 'signup.eyebrow'|trans }}</p>
    <h1>{{ 'signup.page_title'|trans }}</h1>
    <p class="p-text">{{ 'signup.intro'|trans }}</p>

    {{ form_start(form, {attr: {class: 'p-form', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}

        <fieldset>
            <legend>{{ 'signup.legend_business'|trans }}</legend>
            {{ form_row(form.businessName) }}
            {{ form_row(form.contactName) }}
            <div class="p-form-2">
                {{ form_row(form.phone) }}
                {{ form_row(form.whatsapp) }}
            </div>
            {{ form_row(form.message) }}
        </fieldset>

        <fieldset>
            <legend>{{ 'signup.legend_address'|trans }}</legend>
            <p class="p-form-note">{{ 'signup.address_note'|trans }}</p>
            {{ form_row(form.streetAddress) }}
            <div class="p-form-2">
                {{ form_row(form.postalCode) }}
                {{ form_row(form.city) }}
            </div>
            {{ form_row(form.country) }}
            {{ form_row(form.serviceArea) }}
            {{ form_row(form.taxId) }}
        </fieldset>

        <fieldset>
            <legend>{{ 'signup.legend_website'|trans }}</legend>
            {{ form_row(form.domain) }}
            {{ form_row(form.locales) }}
            {{ form_row(form.defaultLocale) }}
        </fieldset>

        <fieldset>
            <legend>{{ 'signup.legend_plan'|trans }}</legend>
            {{ form_row(form.billingPlan) }}
        </fieldset>

        <fieldset>
            <legend>{{ 'signup.legend_login'|trans }}</legend>
            {{ form_row(form.email) }}
            {{ form_row(form.plainPassword.first) }}
            {{ form_row(form.plainPassword.second) }}
        </fieldset>

        {{ form_row(form.consent) }}
        {{ form_row(form.website) }}

        {% if turnstile_site_key() %}
            <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key() }}" data-action="signup" data-language="{{ app.request.locale }}"></div>
            <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        {% endif %}

        <button type="submit" class="p-btn p-btn-primary">{{ 'signup.submit'|trans }}</button>
    {{ form_end(form) }}
{% endblock %}
