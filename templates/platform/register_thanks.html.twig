{% extends 'platform/layout.html.twig' %}
{% trans_default_domain 'platform' %}

{% block title %}{{ 'signup.thanks_title'|trans }} | {{ brand }}{% endblock %}

{% block body %}
    <p class="p-eyebrow">{{ 'signup.thanks_eyebrow'|trans }}</p>
    <h1>{{ 'signup.thanks_title'|trans }}</h1>
    <p class="p-text">{{ 'signup.thanks_text'|trans }}</p>
    <p><a class="p-btn p-btn-ghost" href="{{ path('site_home', {_locale: app.request.locale}) }}">{{ 'signup.thanks_back'|trans }}</a></p>
{% endblock %}
