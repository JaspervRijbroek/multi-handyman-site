{% extends 'platform/layout.html.twig' %}
{% trans_default_domain 'platform' %}

{% block title %}{{ 'password.title'|trans }} | {{ brand }}{% endblock %}

{% block body %}
    {% if form %}
        <h1>{{ 'password.title'|trans }}</h1>
        <p class="p-text">{{ 'password.intro'|trans({'%email%': email}) }}</p>
        {{ form_start(form, {attr: {class: 'p-form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}
            <button type="submit" class="p-btn p-btn-primary">{{ 'password.save'|trans }}</button>
        {{ form_end(form) }}
    {% else %}
        <h1>{{ 'password.expired_title'|trans }}</h1>
        <p class="p-text">{{ 'password.expired_text'|trans }}</p>
        <p><a class="p-btn p-btn-ghost" href="{{ path('app_login') }}">{{ 'password.to_login'|trans }}</a></p>
    {% endif %}
{% endblock %}
