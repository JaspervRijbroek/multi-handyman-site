{% extends 'platform/layout.html.twig' %}

{% block title %}Choose your password | {{ brand }}{% endblock %}

{% block body %}
    {% if form %}
        <h1>Choose your password</h1>
        <p class="p-text">For your login <strong>{{ email }}</strong>. Use at least 10 characters.</p>
        {{ form_start(form, {attr: {class: 'p-form', novalidate: 'novalidate'}}) }}
            {{ form_row(form.password.first) }}
            {{ form_row(form.password.second) }}
            <button type="submit" class="p-btn p-btn-primary">Save password</button>
        {{ form_end(form) }}
    {% else %}
        <h1>This link has expired</h1>
        <p class="p-text">Links to set a password work once and for 7 days. Reply to your welcome email and we send you a new one.</p>
        <p><a class="p-btn p-btn-ghost" href="{{ path('app_login') }}">Go to login</a></p>
    {% endif %}
{% endblock %}
