{% extends 'platform/base.html.twig' %}

{% set what = trade ? trade.label : 'Local pros' %}

{% block title %}{{ what }}{{ near ? ' near ' ~ near }} | {{ brand }}{% endblock %}

{% block meta %}
    <meta name="description" content="{{ what }}{{ near ? ' near ' ~ near : ' in Spain' }}: see their work and reviews, and contact them directly.">
{% endblock %}

{# Search results are thin, changing pages: keep them out of search engines, but follow the links to the pros #}
{% block robots %}noindex, follow{% endblock %}

{% block main %}
    {% set query = {trade: trade ? trade.value : null, near: near ?: null} %}
    {% set points = results|filter(r => r.tenant.hasCoordinates)|map(r => {
        lat: r.tenant.latitude,
        lon: r.tenant.longitude,
        name: r.tenant.name,
        url: 'https://' ~ r.tenant.primaryDomain.hostname,
        color: r.tenant.primaryColor,
    }) %}
    <main class="p-section p-results-page">
        <div class="p-container">
            {% include 'platform/_search_form.html.twig' %}

            <div class="p-results-head">
                <h1>{{ what }}{% if near %} near {{ near }}{% endif %}</h1>
                <p>
                    {{ results|length }} {{ results|length == 1 ? 'pro' : 'pros' }}
                    {% if near and located %} within {{ max_km }} km{% endif %}
                </p>
                {% if near and located %}
                    <nav class="p-sort" aria-label="Sort">
                        <a href="{{ path('platform_search', query) }}" {% if sort == 'distance' %}aria-current="true"{% endif %}>Nearest</a>
                        <a href="{{ path('platform_search', query|merge({sort: 'rating'})) }}" {% if sort == 'rating' %}aria-current="true"{% endif %}>Highest rated</a>
                    </nav>
                {% endif %}
            </div>

            {% if not located %}
                <p class="p-notice" role="status">We couldn’t find “{{ near }}”. Check the spelling or try a nearby town. Showing all pros for now.</p>
            {% endif %}

            {% if results is empty %}
                <div class="p-empty">
                    <h2>No pros here yet</h2>
                    <p>Try another trade or a bigger town nearby.</p>
                    <a class="p-btn p-btn-ghost" href="{{ path('platform_search') }}">Show all pros</a>
                </div>
            {% else %}
                <div class="p-results">
                    <ol class="p-result-list">
                        {% for result in results %}
                            {% set pro = result.tenant %}
                            {% set site = 'https://' ~ pro.primaryDomain.hostname %}
                            <li class="p-result">
                                <span class="p-result-mark" style="background: {{ pro.primaryColor }}" aria-hidden="true">{{ pro.initials }}</span>
                                <div class="p-result-body">
                                    <h2><a href="{{ site }}">{{ pro.name }}</a></h2>
                                    <p class="p-result-meta">
                                        {% if pro.reviewCount %}
                                            <span class="p-stars" aria-hidden="true">★</span>
                                            <b>{{ pro.reviewAverage|number_format(1) }}</b> ({{ pro.reviewCount }} {{ pro.reviewCount == 1 ? 'review' : 'reviews' }})
                                        {% else %}
                                            No reviews yet
                                        {% endif %}
                                        {% if pro.city %} · {{ pro.city }}{% endif %}
                                        {% if result.km is not null %} · {{ result.km < 1 ? '< 1' : result.km|round }} km{% endif %}
                                    </p>
                                    {% if pro.tagline|localized %}<p class="p-result-tagline">{{ pro.tagline|localized('en') }}</p>{% endif %}
                                    {% if pro.tradeLabels is not empty %}
                                        <ul class="p-chips">
                                            {% for label in pro.tradeLabels %}<li>{{ label }}</li>{% endfor %}
                                        </ul>
                                    {% endif %}
                                </div>
                                <div class="p-result-actions">
                                    <a class="p-btn p-btn-primary" href="{{ site }}">View website →</a>
                                    {% if pro.phoneLink %}<a class="p-btn p-btn-ghost" href="tel:{{ pro.phoneLink }}">Call</a>{% endif %}
                                </div>
                            </li>
                        {% endfor %}
                    </ol>

                    {% if points is not empty %}
                        {# The map is only loaded from OpenStreetMap after a click, like on the client sites #}
                        <div class="p-map" id="p-map"
                             data-points="{{ points|json_encode }}"
                             data-js="{{ asset('vendor/leaflet/leaflet.js') }}"
                             data-css="{{ asset('vendor/leaflet/leaflet.css') }}">
                            <button type="button" class="p-btn p-btn-ghost" id="p-map-load">Show on map</button>
                            <p>The map is loaded from OpenStreetMap when you click.</p>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </main>

    {% if points is not empty %}
        <script>
            document.getElementById('p-map-load').addEventListener('click', function () {
                var box = document.getElementById('p-map');
                var css = document.createElement('link');
                css.rel = 'stylesheet';
                css.href = box.dataset.css;
                document.head.append(css);

                var script = document.createElement('script');
                script.src = box.dataset.js;
                script.onload = function () {
                    box.replaceChildren();
                    box.classList.add('is-loaded');
                    var map = L.map(box);
                    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                    }).addTo(map);

                    var bounds = [];
                    JSON.parse(box.dataset.points).forEach(function (point) {
                        var link = document.createElement('a');
                        link.href = point.url;
                        link.textContent = point.name;
                        L.circleMarker([point.lat, point.lon], {radius: 10, color: '#fff', weight: 3, fillColor: point.color, fillOpacity: 1})
                            .bindPopup(link)
                            .addTo(map);
                        bounds.push([point.lat, point.lon]);
                    });
                    map.fitBounds(bounds, {padding: [40, 40], maxZoom: 12});
                };
                document.head.append(script);
            });
        </script>
    {% endif %}
{% endblock %}
