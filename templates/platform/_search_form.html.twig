{# The "what / where" search box. Needs: trades, towns, trade (selected Trade or null), near #}
<form class="p-search" action="{{ path('platform_search') }}" method="get" role="search">
    <label class="p-search-field">
        <span>What needs doing?</span>
        <select name="trade">
            <option value="">Any trade</option>
            {% for option in trades %}
                <option value="{{ option.value }}" {% if trade == option %}selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
        </select>
    </label>
    <label class="p-search-field">
        <span>Where in Spain?</span>
        <input type="text" name="near" value="{{ near }}" list="p-towns" placeholder="Town, e.g. Jávea" autocomplete="address-level2">
        <datalist id="p-towns">
            {% for town in towns %}<option value="{{ town }}"></option>{% endfor %}
        </datalist>
    </label>
    <button type="submit" class="p-btn p-btn-primary">Search</button>
</form>
