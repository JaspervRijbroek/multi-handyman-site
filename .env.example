# Committed defaults for local development with DDEV.
# Override per machine in .env.local, and in production with real environment
# variables or .env.local (never commit production secrets).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

# Hostname of the platform itself: serves /admin, /login and your own landing page.
# Every other hostname is looked up in the "domain" table and served as a client site.
PLATFORM_HOST=multi-handyman-site.ddev.site

# Sender address for enquiry notifications
MAILER_FROM=no-reply@multi-handyman-site.ddev.site

# Proxies allowed to set X-Forwarded-* headers (DDEV router locally, Caddy in production)
TRUSTED_PROXIES=PRIVATE_SUBNETS

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://db:db@db:3306/db?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# DDEV ships Mailpit on port 1025: open it with "ddev mailpit"
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###
