# Committed defaults for local development with DDEV.
# Override per machine in .env.local, and in production with real environment
# variables or .env.local (never commit production secrets).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

# Hostname of the platform itself: serves /admin, /login and your own landing page.
# Every other hostname is looked up in the "domain" table and served as a client site.
PLATFORM_HOST=multi-handyman-site.ddev.site

# Sender address for enquiry notifications
MAILER_FROM=no-reply@multi-handyman-site.ddev.site

# Proxies allowed to set X-Forwarded-* headers (DDEV router locally, Caddy in production)
TRUSTED_PROXIES=PRIVATE_SUBNETS

# ── Client onboarding ────────────────────────────────────────────────────────
# Clients without their own domain get <slug>.CLIENT_SUBDOMAIN_BASE (needs a
# wildcard DNS record *.CLIENT_SUBDOMAIN_BASE → server). Leave empty to disable.
CLIENT_SUBDOMAIN_BASE=

# Google Search Console (README → "Google setup"). Everything works without it;
# the Search Console step is then skipped.
# Service account key for Search Console: path to the JSON file (relative to the
# project) or the JSON itself. Keep the key out of Git (e.g. in .env.local or var/).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Your own Google account(s), made owner of every client's Search Console property
GOOGLE_OWNER_EMAILS=

# Map positions come from OpenStreetMap's Nominatim, no key needed. Optional:
# your own Nominatim server, and the User-Agent sent to it (their usage policy
# asks for one that identifies the application; defaults to the platform URL)
NOMINATIM_URL=
NOMINATIM_USER_AGENT=

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://db:db@db:3306/db?serverVersion=11.4.0-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# DDEV ships Mailpit on port 1025: open it with "ddev mailpit"
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> billing (Mollie) ###
# Test key (test_...) from https://my.mollie.com > Developers > API keys. Use the live key in production.
MOLLIE_API_KEY=
# Monthly price in cents, excluding VAT (per client override in the admin)
BILLING_MONTHLY_PRICE=5900
BILLING_VAT_RATE=21
BILLING_CURRENCY=EUR
# The platform brand: shown on the platform pages, in payment descriptions, emails and the payment page
BILLING_BRAND="CasitaFix"
# Mollie cannot reach a local DDEV site, so webhooks are off locally: the return page
# and the daily app:billing:run check payment statuses instead. Set to 1 in production.
BILLING_WEBHOOKS=0
###< billing (Mollie) ###

###> Cloudflare Turnstile (spam protection for the contact and login forms) ###
# Production: an API token with "Account > Turnstile > Edit" (dash.cloudflare.com > My Profile > API Tokens)
# and your account ID. The app then creates the Turnstile widgets itself and adds every
# client domain to them (app:turnstile:sync). Leave empty to turn this off.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hostnames Cloudflare allows on one widget (10 on the free plan); more widgets are created when full
TURNSTILE_HOSTNAMES_PER_WIDGET=10
# managed, non-interactive or invisible (only used for new widgets)
TURNSTILE_WIDGET_MODE=managed
# Without an API token: one fixed widget. Cloudflare's test keys always pass, handy locally:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
###< Cloudflare Turnstile ###
